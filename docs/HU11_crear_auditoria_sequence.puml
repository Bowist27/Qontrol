@startuml
title HU11 - Crear Auditoría (Preview antes de Guardar)

skinparam BoxPadding 10
skinparam SequenceMessageAlignment center
skinparam ParticipantPadding 10

actor "Admin/Gerente" as User

box "Frontend (React)\napps/web-admin/src/" #WhiteSmoke
    boundary "components/audits/\nAuditSessionDetail.tsx" as Page <<Component>>
    control "services/\naudit.api.ts" as API <<HTTP Client>>
end box

box "Audit Service (Go)\nservices/audit-service/" #Honeydew
    boundary "adapters/handler/\naudit_handler.go" as Handler <<HTTP Handler>>
    control "core/services/\naudit_service.go" as Service <<Business Logic>>
    control "adapters/repository/\npostgres_repo.go" as Repo <<Repository>>
end box

box "External Infrastructure" #LightYellow
    database "PostgreSQL" as DB <<Database>>
    collections "AWS S3" as S3 <<Object Storage>>
end box


== 🟢 FASE 1: Inicialización ==

User -> Page: Clic "Nueva Auditoría"
activate Page

Page ->> API: getStores()
activate API
    API ->> Handler: GET /api/stores
    activate Handler
        Handler ->> Service: ListStores()
        activate Service
            Service ->> Repo: FindAllStores()
            activate Repo
                Repo ->> DB: SELECT * FROM stores WHERE active=true
                DB -->> Repo: []Store
            deactivate Repo
            Service -->> Handler: []StoreDTO
        deactivate Service
        Handler -->> API: 200 JSON {stores: [...]}
    deactivate Handler
deactivate API
Page <<-- API: stores[]
Page -> Page: Renderiza dropdown de tiendas

== 🟡 FASE 2: Selección Tienda + Subir PDF ==

User -> Page: Selecciona tienda
User -> Page: Arrastra/Sube PDF de valuación
Page -> Page: Prepara FormData {store_id, file}

Page ->> API: parsePDF(store_id, file)
activate API
    API ->> Handler: POST /api/audits/parse
    activate Handler

== 🔵 FASE 3: Parseo (SIN guardar) ==

        Handler ->> Service: ParseAuditPDF(storeID, pdf)
        activate Service
            
            note right of Service
                **SOLO PARSEA - NO GUARDA**
                El PDF se procesa en memoria
                No hay INSERT a DB todavía
            end note
            
            Service -> Service: items := ParsePDF(pdf)
            
            alt Parseo Fallido
                Service -->> Handler: Error 400
                Handler -->> API: 400 Bad Request
            else Parseo Exitoso
                Service -->> Handler: ParseResult{items, summary}
            end
            
        deactivate Service
        Handler -->> API: 200 OK {items: [...], totalItems, totalValue}
    deactivate Handler
deactivate API

== 🟠 FASE 4: Previsualización ==

Page -> Page: setPreviewItems(items)
note right of Page
  **Tabla muestra 3 Tabs:**
  • **Todos (1250)**: Items del PDF
  • **Discrepancias (0)**: Aún vacío
  • **Extras (0)**: Aún vacío
  
  Usuario revisa ANTES de guardar.
  Puede cancelar sin datos en DB.
end note

Page -> Page: Renderiza Tabla "Todos (1250)"
User -> Page: Revisa items del PDF
User -> Page: Clic "Guardar Auditoría"

== 🏁 FASE 5: Confirmación (AHORA sí guarda) ==

Page ->> API: confirmAudit(store_id, file)
activate API
    API ->> Handler: POST /api/audits
    activate Handler
        Handler ->> Service: CreateAudit(storeID, pdf)
        activate Service
            
            ' 5.1 - Crear sesión
            Service -> Service: session := NewAuditSession(storeID)
            Service ->> Repo: InsertSession(session)
            activate Repo
                Repo ->> DB: INSERT audit_sessions... RETURNING id
                DB -->> Repo: session_id = 505
            deactivate Repo

            ' 5.2 - Upload a S3
            Service ->> S3: PutObject(pdf, key)
            activate S3
            
            alt Subida Fallida
                S3 -->> Service: Error
                Service ->> Repo: DeleteSession(505)
                Service -->> Handler: Error 500
                Handler -->> API: 500 Internal Error
            else Subida Exitosa
                S3 -->> Service: s3_url
            end
            deactivate S3

            ' 5.3 - Parsear y guardar batch
            Service -> Service: items := ParsePDF(pdf)
            
            note right of Service
                **BATCH INSERT**
                Guarda 1250 items + 
                actualiza status en
                una sola transacción.
            end note

            Service ->> Repo: SaveAuditBatch(505, items, s3_url)
            activate Repo
                note right of DB: BEGIN TRANSACTION
                Repo ->> DB: INSERT INTO audit_theoretical VALUES (...) x1250
                Repo ->> DB: UPDATE audit_sessions SET status='IN_PROGRESS', pdf_url=...
                note right of DB: COMMIT
            deactivate Repo

            Service -->> Handler: AuditDTO (Session + Items)
        deactivate Service
        
        Handler -->> API: 201 Created {session_id: 505}
    deactivate Handler
deactivate API

Page -> Page: Muestra "Auditoría creada exitosamente"
Page -> Page: Redirige a AuditHub
deactivate Page

@enduml