@startuml
title HU11 - Crear Auditoría Planificada (Versión Optimizada Batch)

skinparam BoxPadding 10
skinparam SequenceMessageAlignment center
skinparam ParticipantPadding 10

actor "Admin/Gerente" as User

box "Frontend (React)\napps/web-admin/src/" #WhiteSmoke
    boundary "components/audits/\nAuditSessionDetail.tsx" as Page <<Component>>
    control "services/\naudit.api.ts" as API <<HTTP Client>>
end box

box "Audit Service (Go)\nservices/audit-service/" #Honeydew
    boundary "adapters/handler/\naudit_handler.go" as Handler <<HTTP Handler>>
    control "core/services/\naudit_service.go" as Service <<Business Logic>>
    ' CORRECCIÓN UML: Eliminada la línea de vida "Domain" (es lógica interna)
    control "adapters/repository/\npostgres_repo.go" as Repo <<Repository>>
end box

box "External Infrastructure" #LightYellow
    database "PostgreSQL" as DB <<Database>>
    collections "AWS S3" as S3 <<Object Storage>>
end box


== 🟢 FASE 1: Inicialización ==

User -> Page: Clic "Nueva Auditoría"
activate Page

Page ->> API: getStores()
activate API
    API ->> Handler: GET /api/stores
    activate Handler
        Handler ->> Service: ListStores()
        activate Service
            Service ->> Repo: FindAllStores()
            activate Repo
                Repo ->> DB: SELECT * FROM stores
                DB -->> Repo: []Store (Structs)
            deactivate Repo
            Service -->> Handler: []StoreDTO
        deactivate Service
        Handler -->> API: 200 JSON {stores: [...]}
    deactivate Handler
deactivate API
Page <<-- API: stores[]
Page -> Page: Renderiza dropdown

== 🟡 FASE 2: Selección y Envío PDF ==

User -> Page: Selecciona tienda + Sube PDF
Page -> Page: Prepara FormData {store_id, file}

Page ->> API: createAudit(store_id, file)
activate API
    API ->> Handler: POST /api/audits
    activate Handler

== 🔵 FASE 3: Procesamiento Backend ==

        Handler ->> Service: CreateAudit(storeID, pdf)
        activate Service
            
            ' 3.1 - Crear registro borrador (Interno)
            note right of Service
                1. Inicializa Struct (Interno)
                2. Guarda Sesión vacía
            end note
            Service -> Service: session := NewAuditSession(storeID)
            
            Service ->> Repo: InsertSession(session)
            activate Repo
                Repo ->> DB: INSERT audit_sessions... RETURNING id
                DB -->> Repo: session_id = 505
            deactivate Repo

            ' 3.2 - Upload a S3
            Service ->> S3: PutObject(pdf, key)
            activate S3
            
            alt Subida Fallida
                S3 -->> Service: Error
                Service ->> Repo: UpdateStatus(505, "ERROR")
                Service -->> Handler: Error 500
                Handler -->> API: 500 Internal Error
            else Subida Exitosa
                S3 -->> Service: s3_url
            end
            deactivate S3

            ' 3.3 - Parsear PDF
            Service -> Service: items := ParsePDF(pdf)

            ' 3.4 - CORRECCIÓN CRÍTICA: BATCH INSERT (Adiós Loop N+1)
            note right of Service
                OPTIMIZACIÓN:
                Guarda 1250 items + Update Status
                en una sola transacción.
            end note

            Service ->> Repo: SaveAuditBatch(505, items, s3_url)
            activate Repo
                note right of DB: BEGIN TRANSACTION
                Repo ->> DB: INSERT INTO audit_items VALUES (...), (...), (...) \n(Batch de 1250 filas)
                Repo ->> DB: UPDATE audit_sessions SET status='REVIEW_PENDING'...
                note right of DB: COMMIT
            deactivate Repo

            Service -->> Handler: AuditDTO (Session + Items)
        deactivate Service
        
        Handler -->> API: 200 OK {items: [...]}
    deactivate Handler
deactivate API

== 🟠 FASE 4: Previsualización ==

Page -> Page: Renderiza Tabla de Previsualización
User -> Page: Revisa y Clic "Guardar Auditoría"

== 🏁 FASE 5: Confirmación Final ==

Page ->> API: confirmAudit(505)
activate API
    API ->> Handler: POST /api/audits/505/confirm
    activate Handler
        Handler ->> Service: ConfirmAudit(505)
        activate Service
            Service ->> Repo: UpdateStatus(505, "IN_PROGRESS")
            activate Repo
                Repo ->> DB: UPDATE audit_sessions SET status='IN_PROGRESS'
            deactivate Repo
            Service -->> Handler: nil
        deactivate Service
        Handler -->> API: 200 OK
    deactivate Handler
deactivate API

Page -> Page: Redirige a AuditHub
deactivate Page
@enduml